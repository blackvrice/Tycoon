.hotbar-root {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 20px;
    height: 76px;
    align-items: center;
    justify-content: center;
}

.hotbar {
    height: 68px;
    padding: 6px;
    flex-direction: row;
    gap: 6px;
    border-radius: 8px;
    background-color: rgba(24, 28, 34, 0.86);
    border-width: 1px;
    border-color: rgba(236, 241, 248, 0.18);
}

.hotbar-slot {
    width: 56px;
    height: 56px;
    border-radius: 6px;
    background-color: rgb(47, 54, 63);
    border-width: 1px;
    border-color: rgb(83, 94, 108);
}

.hotbar-slot.selected {
    background-color: rgb(62, 70, 78);
    border-width: 3px;
    border-color: rgb(255, 205, 96);
}

.hotbar-slot.drag-source {
    opacity: 0.55;
}

.hotbar-key {
    position: absolute;
    left: 5px;
    top: 3px;
    color: rgb(185, 195, 207);
    font-size: 11px;
    -unity-font-style: bold;
}

.hotbar-slot.selected .hotbar-key {
    color: rgb(255, 229, 168);
}

.hotbar-icon {
    width: 34px;
    height: 34px;
    align-self: center;
    margin-top: 13px;
    -unity-background-scale-mode: scale-to-fit;
}

.hotbar-amount {
    position: absolute;
    right: 5px;
    bottom: 3px;
    color: white;
    font-size: 11px;
    -unity-font-style: bold;
}
