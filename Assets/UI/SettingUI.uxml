<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/SettingUI.uss?fileID=7433441132597879392&amp;guid=2c9e664c96e24780a7a0aaf63787c91e&amp;type=3#SettingUI"/>
    <ui:VisualElement name="SettingRoot" class="setting-screen hidden">
        <ui:VisualElement name="SettingWindow" class="setting-window">
            <ui:VisualElement class="setting-header">
                <ui:Label text="설정" class="setting-title"/>
                <ui:Button name="SettingCloseButton" text="X" class="setting-close-button"/>
            </ui:VisualElement>
            <ui:VisualElement class="setting-section">
                <ui:Label text="오디오" class="section-title"/>
                <ui:VisualElement class="setting-row">
                    <ui:Label text="전체" class="setting-label"/>
                    <ui:Slider name="MasterVolumeSlider" low-value="0" high-value="100" value="80" class="setting-slider"/>
                    <ui:Label name="MasterVolumeValueLabel" text="80%" class="setting-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="setting-row">
                    <ui:Label text="음악" class="setting-label"/>
                    <ui:Slider name="MusicVolumeSlider" low-value="0" high-value="100" value="70" class="setting-slider"/>
                    <ui:Label name="MusicVolumeValueLabel" text="70%" class="setting-value"/>
                </ui:VisualElement>
                <ui:VisualElement class="setting-row">
                    <ui:Label text="효과음" class="setting-label"/>
                    <ui:Slider name="SfxVolumeSlider" low-value="0" high-value="100" value="85" class="setting-slider"/>
                    <ui:Label name="SfxVolumeValueLabel" text="85%" class="setting-value"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="setting-section">
                <ui:Label text="화면" class="section-title"/>
                <ui:VisualElement class="setting-row">
                    <ui:Label text="전체 화면" class="setting-label"/>
                    <ui:Toggle name="FullscreenToggle" value="true" class="setting-toggle"/>
                </ui:VisualElement>
                <ui:VisualElement class="setting-row">
                    <ui:Label text="수직 동기화" class="setting-label"/>
                    <ui:Toggle name="VSyncToggle" value="true" class="setting-toggle"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="setting-section">
                <ui:Label text="게임" class="section-title"/>
                <ui:VisualElement class="game-actions-row">
                    <ui:Button name="SaveGameButton" text="저장" class="secondary-button"/>
                    <ui:Button name="LoadGameButton" text="불러오기" class="secondary-button"/>
                    <ui:Button name="NewGameButton" text="새 게임" class="danger-button"/>
                </ui:VisualElement>
                <ui:Label name="SaveStatusLabel" text="" class="status-label"/>
            </ui:VisualElement>
            <ui:VisualElement class="setting-actions">
                <ui:Button name="ResetSettingsButton" text="초기화" class="secondary-button"/>
                <ui:Button name="QuitGameButton" text="게임 종료" class="danger-button"/>
                <ui:Button name="ResumeButton" text="돌아가기" class="primary-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="NewGameConfirmDialog" class="confirm-dialog hidden">
            <ui:VisualElement class="confirm-window">
                <ui:Label text="새 게임을 시작할까요?" class="confirm-title"/>
                <ui:Label text="현재 진행 상황과 저장 파일이 초기화됩니다." class="confirm-message"/>
                <ui:VisualElement class="confirm-actions">
                    <ui:Button name="CancelNewGameButton" text="취소" class="secondary-button"/>
                    <ui:Button name="ConfirmNewGameButton" text="새 게임" class="danger-button"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
