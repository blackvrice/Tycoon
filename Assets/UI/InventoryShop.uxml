<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/InventoryShop.uss?fileID=7433441132597879392&amp;guid=90fa2b1c77d344fbad1b74eebc36e4fe&amp;type=3#InventoryShop"/>
    <ui:VisualElement name="InventoryShopRoot" class="screen-root hidden">
        <ui:VisualElement class="top-bar">
            <ui:Label text="Tycoon Farm" class="game-title"/>
            <ui:Label name="GoldLabel" text="골드: 0 G" class="gold-label"/>
        </ui:VisualElement>
        <ui:VisualElement class="main-layout">
            <ui:VisualElement name="InventoryPanel" class="panel inventory-panel hidden">
                <ui:VisualElement class="panel-header">
                    <ui:Label text="인벤토리" class="panel-title"/>
                    <ui:Button name="InventoryCloseButton" text="X" class="icon-button"/>
                </ui:VisualElement>
                <ui:Label text="보유 아이템" class="section-label"/>
                <ui:ScrollView class="inventory-scroll">
                    <ui:VisualElement name="InventoryGrid" class="inventory-grid"/>
                </ui:ScrollView>
                <ui:VisualElement class="selected-sale-row">
                    <ui:Label name="SelectedItemLabel" text="선택한 아이템 없음" class="selected-item-label"/>
                    <ui:Button name="SellSelectedButton" text="선택 판매" class="sell-button"/>
                </ui:VisualElement>
                <ui:Label name="InventoryHelpLabel" text="슬롯을 선택한 뒤 다른 인벤토리나 핫바 슬롯을 선택해 이동합니다." class="help-text"/>
            </ui:VisualElement>
            <ui:VisualElement name="ShopPanel" class="panel shop-panel hidden">
                <ui:VisualElement class="panel-header">
                    <ui:Label text="상점" class="panel-title"/>
                    <ui:Button name="ShopCloseButton" text="X" class="icon-button"/>
                </ui:VisualElement>
                <ui:Label text="판매 상품" class="section-label"/>
                <ui:VisualElement class="shop-control-row">
                    <ui:Label text="수량" class="quantity-caption"/>
                    <ui:Button name="ShopQuantityMinusButton" text="-" class="quantity-button"/>
                    <ui:Label name="ShopQuantityLabel" text="1" class="quantity-label"/>
                    <ui:Button name="ShopQuantityPlusButton" text="+" class="quantity-button"/>
                </ui:VisualElement>
                <ui:ScrollView class="shop-scroll">
                    <ui:VisualElement name="ShopList" class="shop-list"/>
                </ui:ScrollView>
                <ui:Label name="ShopMessageLabel" text="" class="shop-message"/>
            </ui:VisualElement>
            <ui:VisualElement name="ItemDetailPanel" class="panel detail-panel">
                <ui:VisualElement class="panel-header">
                    <ui:Label text="아이템" class="panel-title"/>
                </ui:VisualElement>
                <ui:Label name="ItemDetailNameLabel" text="아이템을 선택하세요" class="detail-name"/>
                <ui:Label name="ItemDetailTypeLabel" text="-" class="detail-line"/>
                <ui:Label name="ItemDetailPriceLabel" text="-" class="detail-line"/>
                <ui:Label name="ItemDetailStackLabel" text="-" class="detail-line"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
