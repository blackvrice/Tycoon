.title-screen {
    width: 100%;
    height: 100%;
    padding: 32px;
    align-items: center;
    justify-content: center;
    background-color: rgb(25, 33, 31);
}

.title-menu {
    width: 420px;
    max-width: 88%;
    align-items: center;
}

.title-label {
    margin-bottom: 44px;
    color: rgb(248, 241, 211);
    font-size: 72px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.button-stack {
    width: 260px;
    align-items: stretch;
}

.menu-button {
    height: 56px;
    margin-bottom: 14px;
    border-radius: 8px;
    border-width: 2px;
    border-color: rgb(246, 216, 132);
    color: rgb(255, 250, 230);
    font-size: 24px;
    -unity-font-style: bold;
}

.primary-button {
    background-color: rgb(66, 126, 83);
}

.primary-button:hover {
    background-color: rgb(82, 148, 99);
}

.secondary-button {
    background-color: rgb(46, 57, 64);
}

.secondary-button:hover {
    background-color: rgb(61, 75, 84);
}

.status-label {
    min-height: 24px;
    margin-top: 6px;
    color: rgb(246, 216, 132);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
