.inventory-screen {
    width: 100%;
    height: 100%;
    padding: 24px;
    align-items: center;
    justify-content: center;
    background-color: rgba(18, 20, 24, 0.78);
}

.inventory-window {
    width: 618px;
    padding: 18px;
    border-radius: 18px;
    background-color: rgb(31, 35, 43);
    border-width: 1px;
    border-color: rgb(62, 70, 84);
}

.inventory-header {
    height: 42px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
}

.inventory-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(240, 243, 247);
}

.inventory-close-button {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background-color: rgb(52, 58, 70);
    color: rgb(230, 234, 240);
    font-size: 18px;
    -unity-font-style: bold;
}

.inventory-close-button:hover {
    background-color: rgb(75, 84, 100);
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
}

.inventory-hotbar-grid {
    flex-direction: row;
    gap: 8px;
}

.inventory-slot {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    background-color: rgb(42, 48, 58);
    border-width: 1px;
    border-color: rgb(70, 78, 92);
}

.inventory-slot:hover {
    background-color: rgb(52, 60, 74);
}

.inventory-slot.selected {
    border-width: 3px;
    border-color: rgb(255, 203, 92);
}

.slot-icon {
    width: 40px;
    height: 40px;
    align-self: center;
    margin-top: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.slot-amount {
    position: absolute;
    right: 7px;
    bottom: 5px;
    color: white;
    font-size: 12px;
    -unity-font-style: bold;
}

.hidden {
    display: none;
}
