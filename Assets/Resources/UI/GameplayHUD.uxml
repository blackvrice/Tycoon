<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/UI/GameplayHUD.uss?fileID=7433441132597879392&amp;guid=bc63b644801c409594d93e65bd161ec1&amp;type=3#GameplayHUD"/>
    <ui:VisualElement name="GameplayHudRoot" class="gameplay-hud-root" picking-mode="Ignore">
        <ui:VisualElement class="status-card" picking-mode="Ignore">
            <ui:VisualElement class="status-row" picking-mode="Ignore">
                <ui:Label name="DayLabel" text="1일차" class="status-primary" picking-mode="Ignore"/>
                <ui:Label name="TimeLabel" text="00:00" class="status-primary" picking-mode="Ignore"/>
                <ui:Label name="TickLabel" text="틱 0" class="status-secondary" picking-mode="Ignore"/>
            </ui:VisualElement>
            <ui:Label name="GoldLabel" text="골드: 0 G" class="gold-label" picking-mode="Ignore"/>
            <ui:Label name="SelectionLabel" text="아이템: -" class="selection-label" picking-mode="Ignore"/>
            <ui:Label name="TileInfoLabel" text="밭: -" class="context-label" picking-mode="Ignore"/>
            <ui:Label name="CropInfoLabel" text="작물: -" class="context-label" picking-mode="Ignore"/>
        </ui:VisualElement>

        <ui:VisualElement name="GuidePanel" class="guide-panel">
            <ui:VisualElement class="guide-header">
                <ui:Label name="GuideStepLabel" text="첫 플레이 1/7" class="guide-step" picking-mode="Ignore"/>
                <ui:Button name="SkipGuideButton" text="건너뛰기" class="guide-skip-button"/>
            </ui:VisualElement>
            <ui:Label name="GuideInstructionLabel" text="괭이를 선택하고 밭을 갈아보세요." class="guide-instruction" picking-mode="Ignore"/>
        </ui:VisualElement>

        <ui:VisualElement name="ActionMessagePanel" class="action-message-panel hidden" picking-mode="Ignore">
            <ui:Label name="ActionMessageLabel" text="" class="action-message" picking-mode="Ignore"/>
        </ui:VisualElement>

        <ui:VisualElement name="InteractionPanel" class="interaction-panel hidden" picking-mode="Ignore">
            <ui:Label name="InteractionLabel" text="" class="interaction-label" picking-mode="Ignore"/>
        </ui:VisualElement>

        <ui:Label text="I 인벤토리  ·  B 상점  ·  Esc 설정" class="shortcut-hint" picking-mode="Ignore"/>
    </ui:VisualElement>
</ui:UXML>
